# Evolta Chat — server-side environment variables.
# Copy to your Vercel project settings (Settings → Environment Variables).
# NEVER commit real values. NEVER expose these to the browser.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: comma-separated FREE model slugs, tried in order until one works.
# Every slug MUST end in ":free". Verify current free models at:
#   https://openrouter.ai/models?max_price=0
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,deepseek/deepseek-chat-v3-0324:free

# Optional: CORS allow-list (needed only if the site and proxy are on different origins,
# e.g. site on GitHub Pages, proxy on Vercel). Comma-separated origins.
# ALLOWED_ORIGINS=https://evolta.ai,https://www.evolta.ai

# Optional: best-effort per-IP rate limit (requests per window).
# CHAT_RATE_LIMIT=20
# CHAT_RATE_WINDOW_MS=60000
